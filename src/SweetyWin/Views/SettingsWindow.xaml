<Window x:Class="SweetyWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SweetyWin 설정"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        Background="#1E1E22"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- ── 번역 섹션 ─────────────────────────────────────────── -->
            <TextBlock Text="번역" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="DeepL API 키 (선택)" Margin="0,0,0,4"/>
            <TextBlock Text="비워두면 MyMemory (무료/무키, ~1000단어/일) 사용. DeepL Free 키는 '-xxx:fx' 형식."
                       FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <PasswordBox x:Name="DeepLKeyBox" Margin="0,0,0,16"/>

            <!-- ── 단축키 섹션 ────────────────────────────────────────── -->
            <TextBlock Text="단축키" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12"/>
            <TextBlock x:Name="HotkeyDisplay" Text="" Margin="0,0,0,4"/>
            <TextBlock Text="현재는 settings.json 직접 편집으로 변경. UI 편집은 다음 버전 예정."
                       FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <Button x:Name="OpenSettingsFileBtn" Content="settings.json 열기"
                    HorizontalAlignment="Left" Margin="0,0,0,16"
                    Click="OnOpenSettingsFile"/>

            <!-- ── 동작 섹션 (v0.2.2) ──────────────────────────────── -->
            <TextBlock Text="동작" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12"/>
            <CheckBox x:Name="AutoShowOnDragCheck" Content="드래그/더블클릭 자동 표시"/>
            <TextBlock Text="끄면 Ctrl+Shift+Space 핫키로만 동작. 일부 환경에서 마우스 응답성 문제 발생 시 OFF로 전환 가능."
                       FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- ── 시작 섹션 ──────────────────────────────────────────── -->
            <TextBlock Text="시작" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12"/>
            <CheckBox x:Name="AutoStartCheck" Content="Windows 로그인 시 자동 실행"/>
            <TextBlock Text="HKCU\Run 레지스트리 — 관리자 권한 불필요."
                       FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- ── 진단 (v0.1.4) ────────────────────────────────────── -->
            <TextBlock Text="진단" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,12"/>
            <CheckBox x:Name="DiagnosticLogCheck" Content="진단 로그 활성화 (성능에 영향)"/>
            <TextBlock Text="기본 OFF. 동작 안 함 신고 시에만 켜고, 재현 후 로그 공유. 에러는 항상 기록."
                       FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <Button x:Name="OpenLogBtn" Content="로그 파일 열기"
                    HorizontalAlignment="Left" Margin="0,0,0,16"
                    Click="OnOpenLog"/>

            <!-- ── 액션 버튼 ──────────────────────────────────────────── -->
            <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="취소" Click="OnCancel"/>
                    <Button x:Name="SaveBtn" Content="저장" Click="OnSave"
                            Background="#0A84FF" Foreground="White" BorderBrush="#0A84FF"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
