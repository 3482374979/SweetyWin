<Window x:Class="SweetyWin.Views.QuickPopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SweetyWin QuickPop"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowActivated="True"
        Visibility="Hidden">

    <!-- (v0.2.2) 번역 결과 viewer 단순화 — 액션 메뉴 제거 -->
    <Border CornerRadius="14"
            Background="{StaticResource PaletteBackground}"
            BorderBrush="{StaticResource PaletteBorder}"
            BorderThickness="1"
            Padding="14,10"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            MinWidth="280"
            MaxWidth="520">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- 원본 텍스트 한 줄 미리보기 -->
            <TextBlock x:Name="SourcePreview"
                       Text=""
                       FontSize="11"
                       Foreground="{StaticResource PaletteTertiary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,6"/>

            <!-- 구분선 -->
            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,8"/>

            <!-- 번역 결과 영역 -->
            <Grid MinHeight="40">
                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Height="2"
                             Foreground="{StaticResource PaletteAccent}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Top"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="TranslatedText"
                           Text=""
                           TextWrapping="Wrap"
                           Foreground="{StaticResource PalettePrimary}"
                           FontSize="14"
                           MaxHeight="180"/>
            </Grid>

            <!-- 하단: 언어 방향 / provider + 복사 버튼 + LIPSON Inc. -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DirectionLabel"
                           Grid.Column="0"
                           Text=""
                           FontSize="9"
                           Foreground="{StaticResource PaletteTertiary}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyResultBtn"
                            Content="복사"
                            Style="{StaticResource PaletteActionButton}"
                            FontSize="11"
                            Padding="8,3"
                            Click="OnCopyResultClicked"/>
                    <TextBlock Text="LIPSON Inc."
                               FontSize="9"
                               FontStyle="Italic"
                               Foreground="{StaticResource PaletteTertiary}"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="10,0,2,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
