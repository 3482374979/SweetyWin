<Application x:Class="SweetyWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Acrylic / Mica look — color tokens (light/dark unified for now, refined later) -->
        <SolidColorBrush x:Key="PaletteBackground" Color="#E61E1E22"/>
        <SolidColorBrush x:Key="PaletteBorder" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="PalettePrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PaletteSecondary" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="PaletteTertiary" Color="#88FFFFFF"/>
        <SolidColorBrush x:Key="PaletteHover" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="PaletteAccent" Color="#FF0A84FF"/>

        <!-- Button style — flat, hover-fill -->
        <Style x:Key="PaletteActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PalettePrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource PaletteHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
